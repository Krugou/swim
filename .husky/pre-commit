echo "🔍 Running pre-commit checks..."

# Type-check runs in parallel with the staged-file checks (tests, oxlint, prettier)
npm run type-check --silent &
TYPES_PID=$!

echo "🧪📏🎨 Tests (related), oxlint, prettier on staged files..."
npx lint-staged --quiet || {
  kill $TYPES_PID 2>/dev/null
  echo "❌ Staged checks failed (tests / oxlint / prettier)."
  exit 1
}

wait $TYPES_PID || {
  echo "❌ Type check failed. Fix TypeScript errors before committing."
  exit 1
}

echo "✅ All checks passed!"
