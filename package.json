{
  "name": "nextjs-swim",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "echo '📦 Installing dependencies...'",
    "postinstall": "echo '✅ Dependencies installed successfully!'",
    "dev": "next dev --turbo",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "start": "npm install && npm run dev:turbo",
    "start:prod": "next start",
    "lint": "oxlint app components lib tests e2e",
    "lint:fix": "oxlint app components lib tests e2e --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@radix-ui/react-slot": "^1.3.3",
    "@swc/helpers": "^0.5.23",
    "@tanstack/react-query": "^5.104.0",
    "@types/leaflet": "^1.9.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "next": "16.4.2",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "vitest related --run --passWithNoTests",
      "oxlint --quiet",
      "prettier --check"
    ],
    "*.{json,css,md}": "prettier --check"
  },
  "overrides": {
    "workbox-build": "7.4.1",
    "workbox-webpack-plugin": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
